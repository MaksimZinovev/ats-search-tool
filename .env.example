# Brave Search API key — free tier: 2,000 queries/month, ~1 query/sec
# Get one: https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# TypeSafe API key (System One / Jev) — powers "pages · jobs" filtering
# Get one: https://typesafe.ai
TYPESAFE_API_KEY=

# Ollama Cloud API key (optional) — powers the "Other job boards" section.
# The second search index; not an LLM call, no tokens, results cached 24h.
# Get one: https://ollama.com/settings/keys
OLLAMA_API_KEY=
